{
  "name": "@davisbuilds/fetchmd",
  "version": "0.1.0",
  "description": "Convert any webpage to clean, token-efficient markdown for AI agents",
  "type": "module",
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fetchmd": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:release-commits": "node --test scripts/release-commits.test.cjs",
    "test:dead-code": "vitest run src/dead-code.test.ts",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm test:release-commits",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "markdown",
    "html-to-markdown",
    "cli",
    "readability",
    "ai",
    "web-scraping"
  ],
  "license": "MIT",
  "author": "davisbuilds",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^15.0.0",
    "jsdom": "^30.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "puppeteer": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/turndown": "^5.0.6",
    "puppeteer": "^25.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
